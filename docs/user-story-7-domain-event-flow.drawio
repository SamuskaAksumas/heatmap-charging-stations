        <mxCell id="leg-app-txt" value="Application" style="text;fontSize=9;fillColor=#e8f5e9;strokeColor=#4caf50;rounded=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="legend">
          <mxGeometry x="135" y="25" width="65" height="18" as="geometry" />
        </mxCell>
        <mxCell id="leg-dom-txt" value="Domain" style="text;fontSize=9;fillColor=#fff9c4;strokeColor=#f9a825;rounded=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="legend">
