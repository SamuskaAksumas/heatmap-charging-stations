        <mxCell id="leg-vo-txt" value="Value Object" style="text;fontSize=9;fillColor=#e1bee7;strokeColor=#7b1fa2;rounded=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="legend">
          <mxGeometry x="355" y="25" width="72" height="18" as="geometry" />
        </mxCell>
        <mxCell id="leg-err-txt" value="Exception" style="text;fontSize=9;fillColor=#ffcdd2;strokeColor=#c62828;rounded=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="legend">
