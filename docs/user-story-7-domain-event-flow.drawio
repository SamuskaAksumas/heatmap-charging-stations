        <mxCell id="leg-infra-txt" value="Infrastructure" style="text;fontSize=9;fillColor=#d1e7dd;strokeColor=#198754;rounded=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="legend">
          <mxGeometry x="270" y="25" width="75" height="18" as="geometry" />
