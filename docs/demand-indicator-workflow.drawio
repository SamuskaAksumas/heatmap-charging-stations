<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2024-01-12T12:00:00.000Z" agent="Claude" version="22.1.0">
  <diagram name="Demand Indicator Workflow" id="demand-workflow">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="550" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Demand Indicator Workflow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="250" height="30" as="geometry" />
        </mxCell>

        <!-- User Flow Container -->
        <mxCell id="user-flow" value="User Flow" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="50" width="420" height="400" as="geometry" />
        </mxCell>

        <!-- User opens App -->
        <mxCell id="start" value="User opens App" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="user-flow">
          <mxGeometry x="140" y="40" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Load Data -->
        <mxCell id="load-data" value="Load Data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="user-flow">
          <mxGeometry x="140" y="120" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- Data Available Decision -->
        <mxCell id="decision" value="Data&#xa;Available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="user-flow">
          <mxGeometry x="150" y="190" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- Show Error -->
        <mxCell id="error" value="Show Error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="user-flow">
          <mxGeometry x="300" y="200" width="90" height="40" as="geometry" />
        </mxCell>

        <!-- Calculate Demand -->
        <mxCell id="calculate" value="Calculate Demand Score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="user-flow">
          <mxGeometry x="120" y="280" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- Display Heatmap -->
        <mxCell id="display" value="Display Heatmap on Map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="user-flow">
          <mxGeometry x="120" y="350" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- Arrows in User Flow -->
        <mxCell id="arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=classic;" edge="1" parent="user-flow" source="start" target="load-data">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=classic;" edge="1" parent="user-flow" source="load-data" target="decision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=classic;" edge="1" parent="user-flow" source="decision" target="error">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr3-lbl" value="No" style="text;fontSize=10;fontColor=#666666;" vertex="1" parent="user-flow">
          <mxGeometry x="255" y="200" width="30" height="15" as="geometry" />
        </mxCell>
        <mxCell id="arr4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=classic;" edge="1" parent="user-flow" source="decision" target="calculate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr4-lbl" value="Yes" style="text;fontSize=10;fontColor=#666666;" vertex="1" parent="user-flow">
          <mxGeometry x="205" y="255" width="30" height="15" as="geometry" />
        </mxCell>
        <mxCell id="arr5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=classic;" edge="1" parent="user-flow" source="calculate" target="display">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Data Sources (outside user flow) -->
        <mxCell id="stations-db" value="Charging Stations&#xa;(per PLZ)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="100" height="60" as="geometry" />
        </mxCell>

        <mxCell id="residents-db" value="Residents&#xa;(per PLZ)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="100" height="60" as="geometry" />
        </mxCell>

        <!-- Arrows from data sources -->
        <mxCell id="arr-stations" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;endArrow=classic;dashed=1;fontSize=9;" edge="1" parent="1" source="stations-db" target="load-data">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="170" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arr-residents" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;endArrow=classic;dashed=1;fontSize=9;" edge="1" parent="1" source="residents-db" target="load-data">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="170" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Display Output -->
        <mxCell id="output" value="Show:&#xa;Demand per PLZ&#xa;(yellow → red)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="630" y="390" width="110" height="60" as="geometry" />
        </mxCell>

        <mxCell id="arr-output" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=classic;" edge="1" parent="1" source="display" target="output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Calculation Box -->
        <mxCell id="calc-box" value="Calculation&#xa;&#xa;Demand = Residents / Stations&#xa;&#xa;Higher value = more demand&#xa;for new charging stations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="630" y="170" width="170" height="100" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend" style="swimlane;startSize=20;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="550" height="70" as="geometry" />
        </mxCell>

        <!-- Shapes Row -->
        <mxCell id="leg-shapes-title" value="Shapes:" style="text;fontSize=9;fontStyle=1;" vertex="1" parent="legend">
          <mxGeometry x="10" y="25" width="45" height="15" as="geometry" />
        </mxCell>
        <mxCell id="leg-start-txt" value="Start / Action" style="text;fontSize=9;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="legend">
          <mxGeometry x="60" y="25" width="75" height="18" as="geometry" />
        </mxCell>
        <mxCell id="leg-decision-txt" value="Decision" style="text;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="legend">
          <mxGeometry x="145" y="25" width="55" height="18" as="geometry" />
        </mxCell>
        <mxCell id="leg-display-txt" value="Display" style="text;fontSize=9;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="legend">
          <mxGeometry x="210" y="25" width="48" height="18" as="geometry" />
        </mxCell>
        <mxCell id="leg-error-txt" value="Error" style="text;fontSize=9;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="legend">
          <mxGeometry x="268" y="25" width="38" height="18" as="geometry" />
        </mxCell>
        <mxCell id="leg-data-txt" value="Data Source" style="text;fontSize=9;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="legend">
          <mxGeometry x="316" y="25" width="70" height="18" as="geometry" />
        </mxCell>

        <!-- Arrows Row -->
        <mxCell id="leg-arrows-title" value="Arrows:" style="text;fontSize=9;fontStyle=1;" vertex="1" parent="legend">
          <mxGeometry x="10" y="50" width="45" height="15" as="geometry" />
        </mxCell>

        <mxCell id="leg-flow" value="" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="legend">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="60" y="57" as="sourcePoint" />
            <mxPoint x="100" y="57" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg-flow-txt" value="Flow (next step)" style="text;fontSize=9;fontColor=#666666;" vertex="1" parent="legend">
          <mxGeometry x="105" y="50" width="85" height="15" as="geometry" />
        </mxCell>

        <mxCell id="leg-data-read" value="" style="endArrow=classic;html=1;strokeColor=#999999;strokeWidth=2;dashed=1;" edge="1" parent="legend">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="200" y="57" as="sourcePoint" />
            <mxPoint x="240" y="57" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg-data-read-txt" value="Data Read" style="text;fontSize=9;fontColor=#999999;" vertex="1" parent="legend">
          <mxGeometry x="245" y="50" width="60" height="15" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
