<mxfile host="app.diagrams.net" modified="2024-01-02T12:00:00.000Z" agent="Claude" version="22.1.0">
  <diagram name="Domain Event Flow - Demand" id="demand-domain-flow">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Domain Event Flow - User Story 5: Demand Indicator (nach DDD-Refactoring)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1a237e;" vertex="1" parent="1">
          <mxGeometry x="250" y="15" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- ==================== EXTERNAL DATA ==================== -->
        <mxCell id="ext-layer" value="External Data" style="swimlane;startSize=22;fillColor=#fce4ec;strokeColor=#c2185b;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="220" height="95" as="geometry" />
        </mxCell>

        <mxCell id="ext-data" value="df_stations_count (PLZ, Number)&#xa;df_residents_geo (PLZ, Einwohner, geometry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd9;strokeColor=#c2185b;fontSize=9;align=center;" vertex="1" parent="ext-layer">
          <mxGeometry x="15" y="30" width="190" height="55" as="geometry" />
        </mxCell>

        <!-- ==================== PRESENTATION LAYER ==================== -->
        <mxCell id="ui-layer" value="Presentation Layer (src/presentation/)" style="swimlane;startSize=22;fillColor=#e3f2fd;strokeColor=#1976d2;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="1020" height="95" as="geometry" />
        </mxCell>

        <mxCell id="ui-trigger" value="User selects&#xa;&quot;Demand&quot; layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;fontSize=9;align=center;" vertex="1" parent="ui-layer">
          <mxGeometry x="20" y="32" width="100" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ui-get" value="demand_service.&#xa;get_latest_results()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;fontSize=9;align=center;" vertex="1" parent="ui-layer">
          <mxGeometry x="560" y="32" width="130" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ui-display" value="render_map_layer()&#xa;→ display_demand()&#xa;→ Folium Heatmap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;fontSize=9;align=center;" vertex="1" parent="ui-layer">
          <mxGeometry x="850" y="27" width="155" height="60" as="geometry" />
        </mxCell>

        <!-- ==================== APPLICATION LAYER ==================== -->
        <mxCell id="app-layer" value="Application Layer (src/demand/application/services/)" style="swimlane;startSize=22;fillColor=#e8f5e9;strokeColor=#4caf50;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="285" width="1020" height="95" as="geometry" />
        </mxCell>

        <mxCell id="svc-calc" value="DemandService.calculate_demand&#xa;(df_stations_count, df_residents_geo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=9;align=center;" vertex="1" parent="app-layer">
          <mxGeometry x="180" y="32" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="svc-get" value="DemandService.get_latest_results()&#xa;→ returns DataFrame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=9;align=center;" vertex="1" parent="app-layer">
          <mxGeometry x="560" y="32" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- ==================== DOMAIN LAYER ==================== -->
        <mxCell id="domain-layer" value="Domain Layer (src/demand/domain/)" style="swimlane;startSize=22;fillColor=#fff9c4;strokeColor=#f9a825;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1020" height="120" as="geometry" />
        </mxCell>

        <mxCell id="entity" value="&lt;&lt;Rich Entity&gt;&gt;&#xa;DemandResult&#xa;─────────────&#xa;+ get_demand_category()&#xa;+ is_high_demand()&#xa;+ get_priority_rank()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcedc8;strokeColor=#689f38;fontSize=9;align=center;" vertex="1" parent="domain-layer">
          <mxGeometry x="20" y="25" width="140" height="90" as="geometry" />
        </mxCell>

        <mxCell id="func-calc" value="on_demand_calculated&#xa;(df_stations_count, df_residents_geo)&#xa;────────────────────────────&#xa;1. Merge on PLZ&#xa;2. demand = residents / stations&#xa;   (or residents if stations=0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;fontSize=9;align=center;" vertex="1" parent="domain-layer">
          <mxGeometry x="180" y="25" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="event-class" value="&lt;&lt;Domain Event&gt;&gt;&#xa;DemandCalculatedEvent&#xa;─────────────&#xa;event_id, timestamp&#xa;total_areas, average_demand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=9;align=center;" vertex="1" parent="domain-layer">
          <mxGeometry x="430" y="25" width="160" height="90" as="geometry" />
        </mxCell>

        <mxCell id="func-display" value="display_demand(m, dframe_analysis)&#xa;────────────────────────────&#xa;1. vmax = 95th percentile&#xa;2. LinearColormap yellow → red&#xa;3. GeoJson per PLZ + tooltip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#e64a19;fontSize=9;align=center;" vertex="1" parent="domain-layer">
          <mxGeometry x="760" y="25" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- ==================== INFRASTRUCTURE LAYER ==================== -->
        <mxCell id="infra-layer" value="Infrastructure Layer (src/demand/infrastructure/)" style="swimlane;startSize=22;fillColor=#eceff1;strokeColor=#607d8b;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="1020" height="85" as="geometry" />
        </mxCell>

        <mxCell id="repo" value="DemandRepository&#xa;(implements DemandRepositoryInterface)&#xa;get_analysis() | update_analysis(df)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfd8dc;strokeColor=#607d8b;fontSize=9;align=center;" vertex="1" parent="infra-layer">
          <mxGeometry x="380" y="28" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- ==================== ARROWS ==================== -->

        <!-- External to Service (at startup via main.py) -->
        <mxCell id="arr1" value="main.py startup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=8;strokeWidth=1;dashed=1;strokeColor=#c2185b;" edge="1" parent="1" source="ext-data" target="svc-calc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="150" y="160" />
              <mxPoint x="290" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Service to Domain Function -->
        <mxCell id="arr2" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=8;strokeWidth=1;strokeColor=#7b1fa2;" edge="1" parent="1" source="svc-calc" target="func-calc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Domain Function produces Entity -->
        <mxCell id="arr3" value="produces" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=8;strokeWidth=1;dashed=1;strokeColor=#689f38;" edge="1" parent="1" source="func-calc" target="entity">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="295" y="520" />
              <mxPoint x="90" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Domain Function raises Event -->
        <mxCell id="arr3b" value="raises" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=8;strokeWidth=1;dashed=1;strokeColor=#f9a825;" edge="1" parent="1" source="func-calc" target="event-class">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Service to Repository -->
        <mxCell id="arr4" value="update_analysis()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=8;strokeWidth=1;strokeColor=#607d8b;" edge="1" parent="1" source="svc-calc" target="repo">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="330" y="395" />
              <mxPoint x="330" y="530" />
              <mxPoint x="500" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- UI trigger to UI get -->
        <mxCell id="arr5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=8;strokeWidth=1;strokeColor=#1976d2;" edge="1" parent="1" source="ui-trigger" target="ui-get">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- UI get to Service get -->
        <mxCell id="arr6" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=8;strokeWidth=1;strokeColor=#2e7d32;" edge="1" parent="1" source="ui-get" target="svc-get">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Service get to Repository -->
        <mxCell id="arr7" value="get_analysis()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=8;strokeWidth=1;dashed=1;strokeColor=#607d8b;" edge="1" parent="1" source="svc-get" target="repo">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="395" />
              <mxPoint x="650" y="530" />
              <mxPoint x="500" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- UI get to UI display -->
        <mxCell id="arr8" value="data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=8;strokeWidth=1;dashed=1;strokeColor=#1976d2;" edge="1" parent="1" source="ui-get" target="ui-display">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- UI display to Domain display -->
        <mxCell id="arr9" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=8;strokeWidth=1;strokeColor=#e64a19;" edge="1" parent="1" source="ui-display" target="func-display">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== LEGEND ==================== -->
        <mxCell id="legend" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="850" height="50" as="geometry" />
        </mxCell>

        <mxCell id="leg-txt" value="FLOW: main.py → DemandService.calculate_demand() → on_demand_calculated() → DemandResult (Rich Entity) → Repository  |  UI: get_latest_results() → display_demand() → Map" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="652" width="830" height="25" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
